@* Inline SVG icon component.
   SVG child elements are injected via MarkupString so Blazor's Razor compiler
   cannot accidentally place them in the wrong (HTML) namespace.
   All paths use currentColor so icons inherit CSS color automatically.
   Usage: <Icon Name="close" Size="18" />  *@

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size" height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     class="icon @Class">
    @Content
</svg>

@code {
    [Parameter, EditorRequired] public string Name  { get; set; } = "";
    [Parameter]                 public int    Size  { get; set; } = 20;
    [Parameter]                 public string Class { get; set; } = "";

    private MarkupString Content => new(Paths.GetValueOrDefault(Name, FallbackPath));

    // SVG inner markup keyed by icon name.
    private static readonly Dictionary<string, string> Paths = new()
    {
        // ?? Navigation / actions ?????????????????????????????????????????
        ["close"] =
