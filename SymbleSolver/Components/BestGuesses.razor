@using SymbleSolver.Models
@using SymbleSolver.Services.State

@inject IGameStateService GameState
@implements IDisposable

<div class="panel best-guess-panel">
    <div class="panel-header">
        <span class="panel-title">Best Next Guesses</span>
        <div class="ranker-toggle">
            <button class="@RankerClass(RankerType.Entropy)" @onclick="() => SetRanker(RankerType.Entropy)"
                    title="Maximize information gain (optimal strategy)">
                Entropy
            </button>
            <button class="@RankerClass(RankerType.Frequency)" @onclick="() => SetRanker(RankerType.Frequency)"
                    title="Maximize common letter coverage (fast)">
                Frequency
            </button>
        </div>
    </div>

    @if (GameState.IsLoading)
    {
        <div class="loading-msg">Computing…</div>
    }
    else if (!GameState.RankedGuesses.Any())
    {
        <div class="no-candidates">No suggestions available.</div>
    }
    else
    {
        <ol class="ranking-list">
            @foreach (var (ranking, index) in GameState.RankedGuesses.Select((r, i) => (r, i)))
            {
                <li class="ranking-item @(ranking.IsCandidate ? "is-candidate" : "")">
                    <span class="rank-num">@(index + 1)</span>
                    <button class="rank-word" @onclick="() => OnWordSelected.InvokeAsync(ranking.Word)">
                        @ranking.Word
                    </button>
                    <div class="rank-meta">
                        <span class="rank-score" title="Expected information gain">
                            @(double.IsPositiveInfinity(ranking.Score)
                                ? "∞"
                                : $"{ranking.Score:F2} bits")
                        </span>
                        @if (ranking.IsCandidate)
                        {
                            <span class="rank-badge candidate-badge">answer</span>
                        }
                        else
                        {
                            <span class="rank-badge explorer-badge">explorer</span>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnWordSelected { get; set; }

    protected override void OnInitialized() =>
        GameState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        GameState.OnChanged -= OnStateChanged;

    private void SetRanker(RankerType type) => GameState.SetRankerType(type);

    private string RankerClass(RankerType type) =>
        GameState.State.RankerType == type ? "toggle-btn active" : "toggle-btn";
}
