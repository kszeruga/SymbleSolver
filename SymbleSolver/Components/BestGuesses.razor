@using SymbleSolver.Models
@using SymbleSolver.Services.State

@inject IGameStateService GameState
@implements IDisposable

<div class="panel best-guess-panel">
    <div class="panel-header">
        <span class="panel-title">Best Next Guesses</span>
        <div class="ranker-toggle">
            <button class="@RankerClass(RankerType.Entropy)"
                    @onclick="() => GameState.SetRankerType(RankerType.Entropy)"
                    title="Entropy — minimises expected guesses">
                Entropy
            </button>
            <button class="@RankerClass(RankerType.Frequency)"
                    @onclick="() => GameState.SetRankerType(RankerType.Frequency)"
                    title="Letter frequency — fast heuristic">
                Frequency
            </button>
        </div>
    </div>

    <div class="ranker-description">
        @if (GameState.State.RankerType == RankerType.Entropy)
        {
            <span>Maximises information gained per guess (bits)</span>
        }
        else
        {
            <span>Favours letters most common in remaining words</span>
        }
    </div>

    @if (GameState.IsLoading)
    {
        <div class="loading-msg">Computing…</div>
    }
    else if (!GameState.RankedGuesses.Any())
    {
        <div class="no-candidates">No suggestions available.</div>
    }
    else
    {
        <ol class="ranking-list">
            @foreach (var (ranking, index) in GameState.RankedGuesses.Select((r, i) => (r, i)))
            {
                <li class="ranking-item @(ranking.IsCandidate ? "is-candidate" : "")">
                    <span class="rank-num">@(index + 1)</span>
                    <button class="rank-word" @onclick="() => OnWordSelected.InvokeAsync(ranking.Word)">
                        @ranking.Word
                    </button>
                    <div class="rank-meta">
                        <span class="rank-score" title="@ScoreTitle">
                            @FormatScore(ranking.Score)
                        </span>
                        @if (ranking.IsCandidate)
                        {
                            <span class="rank-badge candidate-badge">answer</span>
                        }
                        else
                        {
                            <span class="rank-badge explorer-badge">explorer</span>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnWordSelected { get; set; }

    protected override void OnInitialized() =>
        GameState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        GameState.OnChanged -= OnStateChanged;

    private string RankerClass(RankerType type) =>
        GameState.State.RankerType == type ? "toggle-btn active" : "toggle-btn";

    private string ScoreTitle => GameState.State.RankerType == RankerType.Entropy
        ? "Expected information gain (bits)"
        : "Letter frequency score";

    private string FormatScore(double score) =>
        double.IsPositiveInfinity(score) ? "?"
        : GameState.State.RankerType == RankerType.Entropy ? $"{score:F2} bits"
        : $"{score:F0}";
}
